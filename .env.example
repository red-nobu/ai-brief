# Email (Gmail: create an app password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password-here
MAIL_TO=you@gmail.com

# LLM keys (only the provider you select in config.yaml is needed; ollama needs none)
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=   # optional: raises GitHub search rate limit (github.com/settings/tokens, no scopes needed)
